{
  "manifest_version": 2,
  "name": "Archive with gyotc",
  "version": "1.0.0",
  "description": "Adds a context menu item that opens https://gyo.tc/<current-page-url> in a new tab.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "archive-with-gyotc@kobar9568.com"
    }
  }
}
